# ============================================================
# Supabase — get these from your Supabase project dashboard
# ============================================================

# Public anon key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# Cloudinary — get these from your Cloudinary dashboard
# ============================================================

# Public cloud name — safe to expose to the browser
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# API credentials — SERVER ONLY, never expose to the browser
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Upload preset (create an unsigned preset in Cloudinary for
# server-side uploads, or leave blank if using signed upload)
CLOUDINARY_UPLOAD_PRESET=balaphoto_uploads
